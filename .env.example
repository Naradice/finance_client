# Copy to .env in the finance_client project root and fill in your settings.
SBI_AI_HEALING=1
# Reuse your usual Chrome (144+): enable chrome://inspect/#remote-debugging,
# then allow Chrome's connection prompt on each connection (Chrome's design).
# The script owns only a new task tab.
# SBI_CHROME_DEBUGGER_ADDRESS=auto
# Optional path for auto discovery; default is LOCALAPPDATA/Google/Chrome/User Data.
# SBI_CHROME_ATTACH_USER_DATA_DIR=C:/Users/your-name/AppData/Local/Google/Chrome/User Data
# Without debugger address, launch Chrome with a fixed custom profile instead.
# This mode doesn't use the per-connection permission dialog; its profile is
# separate from Chrome's standard User Data directory and persists between runs.
# SBI_CHROME_USER_DATA_DIR=C:/path/to/sbi-chrome
# SBI_CHROME_PROFILE_DIRECTORY=Default
# SBI_CHROME_BINARY=C:/Program Files/Google/Chrome/Application/chrome.exe
# Selenium lookup recovery inherits SBI_AI_HEALING. Set 0 to disable only this layer.
# SBI_AI_OPERATION_HEALING=1
# SBI_AI_OPERATION_CACHE_DIR=C:/path/to/sbi_operations
# Phone-authentication wait in the user-started order test (maximum 180 seconds).
# SBI_PHONE_AUTH_TIMEOUT_SECONDS=180
SBI_AI_MODEL=
OPENAI_API_KEY=
sbi_id=
sbi_password=
# Read-only mode does not require a trading password.
# sbi_trade_password=
# SBI_AI_CACHE_DIR=
# Email recovery inherits SBI_AI_HEALING; set 0 to disable AI for email parsing.
# SBI_AI_EMAIL_HEALING=1
# Gmail OAuth client credentials and saved token (absolute paths recommended).
# SBI_GMAIL_CREDENTIALS_FILE=C:/path/to/credentials.json
# SBI_GMAIL_TOKEN_FILE=C:/path/to/token.json
